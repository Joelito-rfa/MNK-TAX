# Ports exposés
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Base de données
POSTGRES_DB=mnktax
POSTGRES_USER=mnktax
POSTGRES_PASSWORD=changeme

# Sécurité JWT — à remplacer en production par une valeur aléatoire robuste
# Générez une : openssl rand -base64 64
JWT_SECRET=Y2hhbmdlLW1lLWludGVybmFsLXNlY3JldC1mb3ItbW5rLXRheC1wcm90b3R5cGUtMDAx

# Données de démonstration (comptes fictifs)
SEED_DEMO=true

# URL publique du frontend (base des QR codes de quittances)
RECEIPT_BASE_URL=http://localhost:3000

# ── Centre de communication — Email (SMTP réel) ─────────────────
# Sans MAIL_HOST, le canal EMAIL reste INCOMPLETE et tout envoi passe
# explicitement en FAILED (jamais de faux statut « envoyé »).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_ADDRESS=no-reply@mnk-tax.mg
MAIL_FROM_NAME=MNK-TAX — Administration fiscale
MAIL_BASE_URL=http://localhost:3000

# ── Centre de communication — SMS (fournisseur réel) ────────────
# SMS_PROVIDER=twilio + credentials pour activer le canal SMS.
SMS_PROVIDER=none
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# ── Centre de communication — File d'envoi / tests ──────────────
COMM_QUEUE_BATCH_SIZE=50
COMM_QUEUE_MAX_ATTEMPTS=3
COMM_QUEUE_RETRY_BACKOFF_MINUTES=5
# Fréquence du worker de livraison (ms) — 20s par défaut.
COMM_QUEUE_POLL_DELAY_MS=20000
# Destinations explicites des envois test admin (Paramètres → Communications)
COMM_TEST_EMAIL=
COMM_TEST_SMS=
# Fournisseur de démonstration (log uniquement) : si true, EMAIL/SMS simulés et
# marqués comme envoyés sans SMTP ni Twilio réels. Mettre false en production
# réelle pour que les envois non configurés passent en FAILED.
COMM_DEMO_PROVIDER=true

# ── Planificateur (crons + pool de threads) ─────────────────────
# Relances automatiques (rappels déclaration/paiement J-7/J-3/J-1/J-0, relances, mises en demeure)
COMM_SCHEDULER_CRON=0 15 7 * * *
# Détection des retards (créances/obligations)
OVERDUE_SCHEDULER_CRON=0 30 6 * * *
# Notifications internes d'échéance aux agents
DEADLINE_SCHEDULER_CRON=0 0 7 * * *
# Fuseau des crons (Indian/Antananarivo = UTC+3)
SCHEDULER_TIMEZONE=Indian/Antananarivo
# Taille du pool partagé par les crons et le worker de livraison
SCHEDULER_POOL_SIZE=4
