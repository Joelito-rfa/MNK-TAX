# Ports exposés
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Base de données
POSTGRES_DB=mnktax
POSTGRES_USER=mnktax
POSTGRES_PASSWORD=changeme

# Sécurité JWT — OBLIGATOIRE, aucun secret de repli dans le code.
# Générez une valeur : openssl rand -base64 64
JWT_SECRET=

# Données de démonstration (comptes fictifs) — false par défaut.
# Mettre true uniquement pour une démonstration locale.
SEED_DEMO=false

# URL publique du frontend (base des QR codes de quittances)
RECEIPT_BASE_URL=http://localhost:3000

# ── Centre de communication — Email (SMTP ou API MailerSend) ────
# En développement (profil dev), le backend charge automatiquement .env.local
# puis .env (les variables système restent prioritaires). Mettez donc vos
# identifiants réels dans .env.local — jamais dans .env.example.
# Fournisseur : smtp (défaut) ou mailersend (API HTTPS).
MAIL_PROVIDER=smtp
# Jeton API MailerSend — requis uniquement avec MAIL_PROVIDER=mailersend.
# IMPORTANT : le domaine d'essai (*.mlsender.net) est limité à 2 destinataires
# uniques. Pour écrire à de vraies adresses, vérifiez votre propre domaine
# (MailerSend → Email → Domains) puis mettez MAIL_FROM_ADDRESS sur ce domaine.
MAILERSEND_API_TOKEN=
MAILERSEND_API_URL=https://api.mailersend.com/v1/email
# SMTP — requis uniquement avec MAIL_PROVIDER=smtp.
# Sans fournisseur configuré, le canal EMAIL reste INCOMPLETE et tout envoi
# passe explicitement en FAILED (jamais de faux statut « envoyé »).
# Un fournisseur réel est aussi requis pour transmettre les mots de passe
# temporaires : la réinitialisation échoue explicitement sans lui.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Port 465 : MAIL_SMTP_SSL=true (le port 465 l'active automatiquement).
MAIL_SMTP_SSL=false
# Hôtes de confiance TLS, séparés par des virgules (vide = validation standard).
MAIL_SMTP_SSL_TRUST=
MAIL_DEBUG=false
MAIL_FROM_ADDRESS=no-reply@mnk-tax.mg
MAIL_FROM_NAME=MNK-TAX — Administration fiscale
MAIL_BASE_URL=http://localhost:3000

# ── Centre de communication — SMS (fournisseur réel) ────────────
# SMS_PROVIDER=twilio + credentials pour activer le canal SMS.
SMS_PROVIDER=none
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# ── Centre de communication — File d'envoi / tests ──────────────
COMM_QUEUE_BATCH_SIZE=50
COMM_QUEUE_MAX_ATTEMPTS=3
COMM_QUEUE_RETRY_BACKOFF_MINUTES=5
# Fréquence du worker de livraison (ms) — 20s par défaut.
COMM_QUEUE_POLL_DELAY_MS=20000
# Destinations explicites des envois test admin (Paramètres → Communications)
COMM_TEST_EMAIL=
COMM_TEST_SMS=
# Fournisseur de démonstration (log uniquement) : si true, EMAIL/SMS simulés et
# marqués comme envoyés sans SMTP ni Twilio réels. Mettre false en production
# réelle pour que les envois non configurés passent en FAILED.
# ⚠️ Tant que ce mode est actif, AUCUN email réel n'est envoyé : le composeur
#    affiche « mode démonstration » et le suivi des envois marque les livraisons
#    « simulées ». Configurez MAIL_HOST (SMTP) ou MAILERSEND_API_TOKEN pour de
#    vrais envois, puis mettez COMM_DEMO_PROVIDER=false.
COMM_DEMO_PROVIDER=true

# ── Planificateur (crons + pool de threads) ─────────────────────
# Relances automatiques (rappels déclaration/paiement J-7/J-3/J-1/J-0, relances, mises en demeure)
COMM_SCHEDULER_CRON=0 15 7 * * *
# Détection des retards (créances/obligations)
OVERDUE_SCHEDULER_CRON=0 30 6 * * *
# Notifications internes d'échéance aux agents
DEADLINE_SCHEDULER_CRON=0 0 7 * * *
# Fuseau des crons (Indian/Antananarivo = UTC+3)
SCHEDULER_TIMEZONE=Indian/Antananarivo
# Taille du pool partagé par les crons et le worker de livraison
SCHEDULER_POOL_SIZE=4
